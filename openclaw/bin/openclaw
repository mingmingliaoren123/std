#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENTRY="$ROOT/app/node_modules/openclaw/openclaw.mjs"
RELEASE_ROOT="$(cd "$ROOT/.." && pwd)"

if [[ -n "${OPENCLAW_NODE:-}" ]]; then
  NODE="$OPENCLAW_NODE"
elif [[ -x /usr/bin/node ]]; then
  NODE=/usr/bin/node
else
  NODE="$(command -v node || true)"
fi

if [[ -z "$NODE" ]]; then
  echo "Node.js is not available in the current box environment." >&2
  exit 1
fi

if [[ ! -x "$NODE" ]]; then
  echo "Node.js is not executable: $NODE" >&2
  exit 1
fi

if ! "$NODE" -e '
  const [major, minor, patch] = process.versions.node.split(".").map(Number);
  const compatible =
    (major === 22 && (minor > 22 || (minor === 22 && patch >= 3))) ||
    (major === 24 && minor >= 15) ||
    (major >= 25 && (major > 25 || minor >= 9));
  process.exit(compatible ? 0 : 1);
'; then
  echo "OpenClaw requires Node.js >=22.22.3 <23, >=24.15.0 <25, or >=25.9.0; found $($NODE --version)" >&2
  exit 1
fi

if [[ ! -f "$ENTRY" ]]; then
  echo "OpenClaw application missing: $ENTRY" >&2
  exit 1
fi

export PATH="$(dirname "$NODE"):$PATH"
export OPENCLAW_HOME="${OPENCLAW_HOME:-$RELEASE_ROOT/data/openclaw-home}"
export OPENCLAW_STATE_DIR="${OPENCLAW_STATE_DIR:-$RELEASE_ROOT/data/openclaw-state}"
export OPENCLAW_CONFIG_PATH="${OPENCLAW_CONFIG_PATH:-$OPENCLAW_STATE_DIR/openclaw.json}"
export OPENCLAW_PROFILE="${OPENCLAW_PROFILE:-sta100}"
export OPENCLAW_GATEWAY_PORT="${OPENCLAW_GATEWAY_PORT:-19011}"
mkdir -p "$OPENCLAW_HOME" "$OPENCLAW_STATE_DIR"

if [[ "${1:-}" == "gateway" && -x "$ROOT/scripts/bootstrap-state.sh" ]]; then
  "$ROOT/scripts/bootstrap-state.sh"
fi

exec "$NODE" "$ENTRY" "$@"
