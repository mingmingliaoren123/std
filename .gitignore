# OpenClaw dependencies are restored by openclaw/scripts/deploy.sh.
openclaw/app/node_modules/

# Downloaded packages and bundled runtimes are deployment caches.
openclaw/downloads/
openclaw/runtime/

# Runtime state backups can contain customer data and credentials.
openclaw/backups/

# Generated STA-100 release artifacts. Keep release/README-DEPLOY.md tracked.
release/sta100-release/
release/*.tar.gz
